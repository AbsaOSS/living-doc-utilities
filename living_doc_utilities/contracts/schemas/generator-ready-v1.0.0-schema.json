{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://absaoss.github.io/living-doc-utilities/schemas/generator-ready-v1.0.0-schema.json",
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "One acceptance criterion, in the AC-block grammar's shape.",
      "properties": {
        "id": {
          "pattern": "^[A-Z]+-\\d+-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "planned",
            "in_review",
            "active",
            "deprecated"
          ],
          "title": "State",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "aspect": {
          "items": {
            "type": "string"
          },
          "title": "Aspect",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "not_in_scope": {
          "items": {
            "type": "string"
          },
          "title": "Not In Scope",
          "type": "array"
        },
        "removal_planned": {
          "anyOf": [
            {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removal Planned"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "placeholder_values": {
          "title": "Placeholder Values",
          "type": "object",
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "required": [
        "id",
        "state",
        "description"
      ],
      "title": "AcceptanceCriterion",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "planned"
              }
            },
            "required": [
              "state"
            ]
          },
          "else": {
            "properties": {
              "version": {
                "type": "string"
              }
            },
            "required": [
              "version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "deprecated"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "removal_planned": {
                "type": "string"
              }
            },
            "required": [
              "removal_planned"
            ]
          },
          "else": {
            "properties": {
              "removal_planned": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AuditStats": {
      "additionalProperties": false,
      "description": "The stats carried per input inside metadata.source_inputs[] (R7): an audit record of\nanother contract's paths, so field_occupancy is pattern-checked rather than enumerated.",
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "field_occupancy": {
          "title": "Field Occupancy",
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*(\\[\\])?(\\.[a-z][a-z0-9_]*(\\[\\])?)*$"
          }
        }
      },
      "required": [
        "cardinality"
      ],
      "title": "AuditStats",
      "type": "object"
    },
    "Cardinality": {
      "additionalProperties": false,
      "description": "Fixed record counts carried in metadata.stats.cardinality (R11).",
      "properties": {
        "entities": {
          "default": 0,
          "title": "Entities",
          "type": "integer"
        },
        "entities_by_type": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "DocumentedUserStory",
              "DocumentedFeature",
              "DocumentedFunctionality"
            ]
          },
          "title": "Entities By Type",
          "type": "object"
        },
        "acceptance_criteria": {
          "default": 0,
          "title": "Acceptance Criteria",
          "type": "integer"
        },
        "scenarios": {
          "default": 0,
          "title": "Scenarios",
          "type": "integer"
        },
        "warnings_by_code": {
          "title": "Warnings By Code",
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "sources_configured": {
          "default": 0,
          "title": "Sources Configured",
          "type": "integer"
        },
        "sources_failed": {
          "default": 0,
          "title": "Sources Failed",
          "type": "integer"
        },
        "unresolved_refs": {
          "default": 0,
          "title": "Unresolved Refs",
          "type": "integer"
        },
        "entities_skipped": {
          "default": 0,
          "title": "Entities Skipped",
          "type": "integer"
        }
      },
      "title": "Cardinality",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "description": "The transform's selected entities, each carried at its full authored shape.",
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        }
      },
      "title": "Content",
      "type": "object"
    },
    "ContractWarning": {
      "additionalProperties": false,
      "description": "One entry of an artifact's top-level warnings[] array.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ContractWarning",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "description": "What the generator titles and filters by (docs/contracts.md, \"The metadata envelope\").",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "view": {
          "enum": [
            "inner",
            "release"
          ],
          "title": "View",
          "type": "string"
        },
        "selection_summary": {
          "$ref": "#/$defs/SelectionSummary"
        }
      },
      "required": [
        "title",
        "version",
        "view",
        "selection_summary"
      ],
      "title": "Document",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "A documented User Story, Feature or Functionality.\n\nEvery authored field of every entity type lives here, at its authored level; a field\nthat does not apply to a given entity's type is simply absent. Which headings are\nrequired for which type is a parsing-time concern (a later package) - this model only\nfixes the contract's shape. The cross-cutting invariants that are structural, not\nparsing-time, are enforced below: a Feature's state is always derived, stub_reason\nonly ever describes a Feature, and every acceptance criterion's id belongs to its\nentity.",
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "type": {
          "enum": [
            "DocumentedUserStory",
            "DocumentedFeature",
            "DocumentedFunctionality"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "state": {
          "enum": [
            "planned",
            "in_review",
            "active",
            "deprecated"
          ],
          "title": "State",
          "type": "string"
        },
        "state_origin": {
          "enum": [
            "authored",
            "derived"
          ],
          "title": "State Origin",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "timestamps": {
          "$ref": "#/$defs/Timestamps"
        },
        "narrative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "business_value": {
          "items": {
            "type": "string"
          },
          "title": "Business Value",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "not_in_scope": {
          "items": {
            "type": "string"
          },
          "title": "Not In Scope",
          "type": "array"
        },
        "deprecated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deprecated At"
        },
        "deprecation_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deprecation Reason"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "surface_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Type"
        },
        "owners": {
          "items": {
            "type": "string"
          },
          "title": "Owners",
          "type": "array"
        },
        "user_stories": {
          "items": {
            "type": "string"
          },
          "title": "User Stories",
          "type": "array"
        },
        "functionalities": {
          "items": {
            "type": "string"
          },
          "title": "Functionalities",
          "type": "array"
        },
        "external_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "External Dependencies",
          "type": "array"
        },
        "stub_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stub Reason"
        },
        "wizard_steps": {
          "items": {
            "type": "string"
          },
          "title": "Wizard Steps",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageRef"
          },
          "title": "Pages",
          "type": "array"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "func_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Func Type"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "entity_id",
        "source_ref",
        "type",
        "title",
        "state",
        "state_origin"
      ],
      "title": "Entity",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "DocumentedFeature"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "state_origin": {
                "const": "derived"
              }
            }
          },
          "else": {
            "properties": {
              "state_origin": {
                "const": "authored"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "DocumentedFeature"
              }
            },
            "required": [
              "type"
            ]
          },
          "else": {
            "properties": {
              "stub_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pages": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "pages": {
                "contains": {
                  "properties": {
                    "is_primary": {
                      "const": true
                    }
                  },
                  "required": [
                    "is_primary"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    },
    "Metadata": {
      "additionalProperties": false,
      "description": "The envelope every contract artifact carries under its top-level metadata key.",
      "properties": {
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "stats": {
          "$ref": "#/$defs/Stats"
        },
        "source_inputs": {
          "items": {
            "$ref": "#/$defs/SourceInputEntry"
          },
          "title": "Source Inputs",
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "producer",
        "source",
        "generated_at",
        "stats",
        "source_inputs"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "PageRef": {
      "additionalProperties": false,
      "description": "One PageObject file backing a Feature's surface - the full header or a\ncross-reference one (living-doc's docs/guides/living-doc-header-types.md,\n\"Feature in a PageObject File\"). Exactly one of a Feature's pages is the full\nheader; the rest are cross-reference headers pointing back via `parent-feat`.",
      "properties": {
        "is_primary": {
          "default": false,
          "title": "Is Primary",
          "type": "boolean"
        },
        "route": {
          "title": "Route",
          "type": "string"
        },
        "page_object": {
          "title": "Page Object",
          "type": "string"
        },
        "owners": {
          "items": {
            "type": "string"
          },
          "title": "Owners",
          "type": "array"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "functionalities": {
          "items": {
            "type": "string"
          },
          "title": "Functionalities",
          "type": "array"
        }
      },
      "required": [
        "route",
        "page_object",
        "purpose"
      ],
      "title": "PageRef",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "Identifies the tool that wrote this specific file (R6).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "utilities_version": {
          "title": "Utilities Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "utilities_version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "CI run context the file was produced under. Audit information only.",
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "run_attempt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Attempt"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha"
        }
      },
      "title": "Run",
      "type": "object"
    },
    "SelectionSummary": {
      "additionalProperties": false,
      "description": "Counts of what the transform's view filter kept and dropped (docs/contracts.md,\nsection 4). A record: exactly these six named properties, nothing else.\n\n`total_entities == included_entities + excluded_entities` always holds: the producer\nderives `excluded_entities` as `total_entities - included_entities` over one fixed\nentity set, so it is a guaranteed identity, not a coincidence - the same check does not\napply to the three acceptance-criteria fields, because the producer only reports\nview-filtered criteria for entities it kept and never tallies criteria belonging to a\ndropped entity, so those three fields are not established as a disjoint partition. This\nidentity is Pydantic-only: JSON Schema has no keyword for a sum across sibling\nproperties, so a consumer validating raw JSON against the generated schema alone (not\nthrough this model) cannot catch a violation.",
      "properties": {
        "total_entities": {
          "minimum": 0,
          "title": "Total Entities",
          "type": "integer"
        },
        "included_entities": {
          "minimum": 0,
          "title": "Included Entities",
          "type": "integer"
        },
        "excluded_entities": {
          "minimum": 0,
          "title": "Excluded Entities",
          "type": "integer"
        },
        "total_acceptance_criteria": {
          "minimum": 0,
          "title": "Total Acceptance Criteria",
          "type": "integer"
        },
        "included_acceptance_criteria": {
          "minimum": 0,
          "title": "Included Acceptance Criteria",
          "type": "integer"
        },
        "excluded_acceptance_criteria": {
          "minimum": 0,
          "title": "Excluded Acceptance Criteria",
          "type": "integer"
        }
      },
      "required": [
        "total_entities",
        "included_entities",
        "excluded_entities",
        "total_acceptance_criteria",
        "included_acceptance_criteria",
        "excluded_acceptance_criteria"
      ],
      "title": "SelectionSummary",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Identifies the one project, and the systems/organizations/repositories, a file documents.",
      "properties": {
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "systems": {
          "items": {
            "enum": [
              "GitHub",
              "AzureDevOps"
            ],
            "type": "string"
          },
          "title": "Systems",
          "type": "array"
        },
        "organizations": {
          "items": {
            "type": "string"
          },
          "title": "Organizations",
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "title": "Repositories",
          "type": "array"
        },
        "extraction_mode": {
          "anyOf": [
            {
              "enum": [
                "markdown",
                "field-map"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Mode"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceInputEntry": {
      "additionalProperties": false,
      "description": "One transform input's provenance and stats (R7). Collector outputs carry none.",
      "properties": {
        "schema_version": {
          "pattern": "^[a-z][a-z-]*-v\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "stats": {
          "$ref": "#/$defs/AuditStats"
        },
        "selected_stats": {
          "$ref": "#/$defs/AuditStats"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "source",
        "stats",
        "selected_stats"
      ],
      "title": "SourceInputEntry",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Provenance pointer back to the tracking system an entity or scenario came from.",
      "properties": {
        "system": {
          "enum": [
            "GitHub",
            "AzureDevOps"
          ],
          "title": "System",
          "type": "string"
        },
        "native_id": {
          "title": "Native Id",
          "type": "string"
        },
        "native_type": {
          "title": "Native Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "tracker_state": {
          "title": "Tracker State",
